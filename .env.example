# ==============================================================================
# EchoRisk AI — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in or customize your values:
#   copy .env.example .env     (Windows Command Prompt / PowerShell)
#   cp .env.example .env       (macOS / Linux)
# ==============================================================================

# Flask Web Server Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Anthropic Claude AI Settings (Optional)
# Leave ANTHROPIC_API_KEY blank to automatically use the built-in deterministic
# rule-based cybersecurity engine fallback!
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Breach Intelligence Service Endpoint (Public & Free XposedOrNot API)
XPOSEDORNOT_API_URL=https://api.xposedornot.com/v1

# Demo / Viva Presentation Mock Mode
# Set to 'false' for live online breach checks via XposedOrNot
# Set to 'true' for offline classroom / viva presentations with deterministic test data
MOCK_MODE=false
